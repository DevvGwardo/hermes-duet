{
  "name": "hermes-duet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A proactive phone assistant for your Hermes agent: one thread, a morning brief, approval cards, background tasks.",
  "scripts": {
    "dev": "npm run build && tsx server/index.ts",
    "dev:web": "vite --config web/vite.config.ts --host 0.0.0.0 --port 3000",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build --config web/vite.config.ts && tsx scripts/precompress.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevvGwardo/hermes-duet.git"
  },
  "keywords": [
    "hermes",
    "hermes-agent",
    "nous-research",
    "pwa",
    "agent",
    "mcp",
    "assistant",
    "bun"
  ]
}
