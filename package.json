{
  "name": "hermes-duet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A proactive phone assistant for your Hermes agent: one thread, a morning brief, approval cards, background tasks.",
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "bun --watch server/index.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "bun server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "demo": "bun scripts/demo.ts",
    "brand": "bun scripts/brand/render.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6",
    "playwright-core": "1.63.0",
    "typescript": "^5.9",
    "vite": "^8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevvGwardo/hermes-duet.git"
  },
  "keywords": [
    "hermes",
    "hermes-agent",
    "nous-research",
    "pwa",
    "agent",
    "mcp",
    "assistant",
    "bun"
  ]
}
