# Copy to .env (gitignored). Everything is optional; defaults in server/config.ts.
# Public HTTPS address you open on your phone (needed for iOS push). Example with Tailscale:
# DUET_PUBLIC_URL=https://your-mac.your-tailnet.ts.net:8443
# DUET_HOST=127.0.0.1
# DUET_PORT=7456
# DUET_INTERNAL_PORT=7457
# DUET_DATA_DIR=./data
# DUET_HERMES_URL=http://127.0.0.1:8642
# DUET_HERMES_KEY=            # defaults to API_SERVER_KEY from $HERMES_HOME/.env
# HERMES_HOME=~/.hermes
# DUET_HERMES_MODEL=hermes-agent
# DUET_USER_NAME=Sam
# DUET_CONTEXT_FILE=./context.local.md
# DUET_RUN_TIMEOUT_MS=2700000 # 45 minutes without an event before a hung run is stopped
# DUET_MAX_BACKGROUND=2
# DUET_LAUNCHD_LABEL=dev.hermes-duet.server
# DUET_LOG_DIR=               # service log directory; default ~/Library/Logs/hermes-duet (macOS) or ${XDG_STATE_HOME:-~/.local/state}/hermes-duet (Linux)
# DUET_SESSION_SCOPE=hermes-duet   # Hermes memory scope; sessions stay bound to the one they started with
# DUET_LEGACY_COOKIE=              # also accept this device-cookie name (older installs)
# Live browser pane (Chrome the globe button drives)
# DUET_CHROME_BIN=            # auto-probes Chrome/Chromium across macOS, Windows, and Linux when unset
# DUET_CHROME_NO_SANDBOX=0    # set to 1 in restricted containers without SYS_ADMIN
# DUET_CHROME_PORT=9333
# DUET_CHROME_PROFILE=            # defaults to $HERMES_HOME/duet-chrome
# DUET_CHROME_WIDTH=760
# DUET_CHROME_QUALITY=45
# DUET_CHROME_FPS_GAP=110
# DUET_CHROME_DEBUG=0         # set to 1 to log CDP attach/disconnect events

# Spending cap & single-use virtual cards for request_payment
# DUET_MAX_TRANSACTION_LIMIT=500         # dollars per payment card (overridden by _CENTS)
# DUET_MAX_TRANSACTION_LIMIT_CENTS=
# DUET_CARD_PROVIDER=privacy             # privacy | stripe | revolut | generic (defaults to privacy when DUET_CARD_KEY is set)
# DUET_CARD_KEY=
# DUET_CARD_URL=                         # optional API base (required for generic)

# Triggers & vault autofill
# DUET_WATCH_DIR=~/Downloads
# DUET_WATCH_DOWNLOADS=1                 # set to 0 to disable the watched folder trigger
# DUET_MEETING_LEAD_MIN=15               # positive minutes before a meeting triggers prep
# DUET_OP_CMD="op item get {domain} --format json"
# DUET_BW_CMD="bw get item {domain} --raw"
# BW_SESSION=                            # Bitwarden CLI session token when using DUET_BW_CMD

# Speech-to-text (voice memos). If unset, auto-detects whisper-cli / whisper-cpp on PATH.
# Install ffmpeg when using local whisper.cpp so browser webm/m4a/ogg recordings transcode to 16kHz WAV.
# Local whisper.cpp example:
# DUET_STT_CMD="whisper-cli -m ~/models/ggml-base.en.bin -f {file} -nt -np"
# OpenAI-compatible HTTP endpoint examples (URL takes precedence over DUET_STT_CMD):
# - Groq Whisper:
# DUET_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# DUET_STT_MODEL=whisper-large-v3-turbo
# DUET_STT_KEY=gsk_...
# - OpenAI:
# DUET_STT_URL=https://api.openai.com/v1/audio/transcriptions
# DUET_STT_MODEL=gpt-4o-mini-transcribe
# DUET_STT_KEY=sk-...

# Text-to-speech ("Listen" on morning briefs). Defaults to macOS `say` + `afconvert` on darwin.
# OpenAI-compatible HTTP endpoint example:
# DUET_TTS_URL=https://api.openai.com/v1/audio/speech
# DUET_TTS_MODEL=tts-1
# DUET_TTS_VOICE=alloy
# DUET_TTS_KEY=sk-...
# Local command example (e.g. Piper on Linux/Windows):
# DUET_TTS_CMD="piper --model ~/models/en_US-lessac-medium.onnx --output_file {out}"
# DUET_TTS_EXT=.wav
